# Mobile Customer App - Environment Variables
# Copy file này thành .env và điền IP máy của bạn

# API URL - Thay <YOUR_LAN_IP> bằng IP LAN của máy bạn
# Android Emulator:  http://10.0.2.2:3000/api
# iOS Simulator:     http://localhost:3000/api
# Physical Device:   http://<YOUR_LAN_IP>:3000/api
REACT_APP_API_URL=https://api.firego.vn/api

REACT_APP_ENV=development

# Google Maps API Configuration
# Lấy API key từ: https://console.cloud.google.com/google/maps-apis
# Cần enable: Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=AIzaSyCR0-z2gtK6ax9qhn3Mhz87oclK84QXrIo
