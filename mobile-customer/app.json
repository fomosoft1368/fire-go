{
  "expo": {
    "name": "Đặt Xe - Khách hàng",
    "slug": "dat-xe-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "entryPoint": "./index.js",
    "icon": "./src/assets/logooo.png",
    "splash": {
      "image": "./src/assets/logooo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.datxe.customer",
      "jsEngine": "jsc",
      "runtimeVersion": {
        "policy": "sdkVersion"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow app to access your location for ride booking",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow app to access your location for ride tracking and history",
        "NSMicrophoneUsageDescription": "App cần quyền micro để thực hiện cuộc gọi thoại với tài xế"
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCR0-z2gtK6ax9qhn3Mhz87oclK84QXrIo"
      }
    },
    "android": {
      "package": "com.datxe.customer",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logooo.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCR0-z2gtK6ax9qhn3Mhz87oclK84QXrIo"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow app to access your location"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf"
          ]
        }
      ],
      "react-native-agora"
    ],
    "extra": {
      "googleMapsApiKey": "AIzaSyCR0-z2gtK6ax9qhn3Mhz87oclK84QXrIo",
      "eas": {
        "projectId": "9a5710ec-b650-46d5-9e18-f594a593533e"
      }
    }
  }
}
