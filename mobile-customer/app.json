{
  "expo": {
    "name": "Đặt Xe - Khách hàng",
    "slug": "dat-xe-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "entryPoint": "./index.js",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.datxe.customer",
      "jsEngine": "jsc",
      "runtimeVersion": {
        "policy": "sdkVersion"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow app to access your location"
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBkL5y6ap46Q2qtKPv9bLtQyf4ZOSRLinw"
      }
    },
    "android": {
      "package": "com.datxe.customer",
      "versionCode": 1,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBkL5y6ap46Q2qtKPv9bLtQyf4ZOSRLinw"
        }
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf"]
        }
      ]
    ],
    "extra": {
      "googleMapsApiKey": "AIzaSyBkL5y6ap46Q2qtKPv9bLtQyf4ZOSRLinw"
    }
  }
}
